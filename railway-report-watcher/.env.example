# Full Google service-account JSON document (single-line or Railway-compatible string).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Railway API token with project access.
RAILWAY_API_TOKEN=

# Resend API key used to send notification emails.
RESEND_API_KEY=

# Recipient email address for report notifications.
NOTIFY_EMAIL=

# RAILWAY_PROJECT_ID, RAILWAY_ENVIRONMENT_ID, and RAILWAY_SERVICE_ID are provided automatically by Railway.
