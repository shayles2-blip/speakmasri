rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /visitedPlaces/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /customPhrases/{phraseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /audioReports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['lessonId','idx','ar','franco','voicePref','reason','note','createdAt'])
        && request.resource.data.lessonId is string && request.resource.data.lessonId.size() > 0 && request.resource.data.lessonId.size() <= 50
        && request.resource.data.idx is int && request.resource.data.idx >= 0
        && request.resource.data.ar is string && request.resource.data.ar.size() > 0 && request.resource.data.ar.size() <= 300
        && request.resource.data.franco is string && request.resource.data.franco.size() <= 300
        && request.resource.data.voicePref in ['male','female']
        && request.resource.data.reason in ['not_egyptian','mispronounced','robotic_glitch','wrong_word','other','translation_wrong','register_wrong','grammar_wrong']
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null && request.auth.token.email == 'mira@speakmasri.com';
      allow update: if false;
      allow delete: if request.auth != null && request.auth.token.email == 'mira@speakmasri.com';
    }

    // Write-only inbox a partner can drop phrase suggestions into via a shareable
    // link. A submission and its pending-counter increment must be in one batch.
    match /partnerSubmissions/{targetUid}/items/{itemId} {
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && request.resource.data.keys().hasOnly(['en', 'ar', 'franco', 'submittedAt'])
        && request.resource.data.en is string && request.resource.data.en.size() > 0 && request.resource.data.en.size() <= 200
        && request.resource.data.ar is string && request.resource.data.ar.size() > 0 && request.resource.data.ar.size() <= 200
        && request.resource.data.franco is string && request.resource.data.franco.size() > 0 && request.resource.data.franco.size() <= 200
        // A serverTimestamp() transform resolves to request.time during rules evaluation.
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.submittedAt == request.time
        && (
          (!exists(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter)
            && getAfter(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending == 1)
          ||
          (get(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending is int
            && get(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending >= 0
            && get(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending < 50
            && getAfter(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending
              == get(/databases/$(database)/documents/partnerSubmissions/$(targetUid)/meta/counter).data.pending + 1)
        );
      allow read, delete: if request.auth != null && request.auth.uid == targetUid;
      allow update: if false;
    }

    match /partnerSubmissions/{targetUid}/meta/counter {
      // Partners need the current value to construct the atomic increment batch.
      allow get: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(targetUid));
      allow list: if false;

      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && request.resource.data.keys().hasOnly(['pending'])
        && (request.resource.data.pending == 1
          || (request.auth.uid == targetUid && request.resource.data.pending == 0));
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && resource.data.keys().hasOnly(['pending'])
        && resource.data.pending is int
        && resource.data.pending >= 0
        && resource.data.pending < 50
        && request.resource.data.keys().hasOnly(['pending'])
        && request.resource.data.pending == resource.data.pending + 1;

      // After pulling the inbox, only its owning learner may clear the count.
      allow update: if request.auth != null
        && request.auth.uid == targetUid
        && request.resource.data.keys().hasOnly(['pending'])
        && request.resource.data.pending == 0;
      allow delete: if request.auth != null && request.auth.uid == targetUid;
    }
  }
}
